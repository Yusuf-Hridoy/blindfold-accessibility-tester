{
  "name": "blindfold-accessibility-tester",
  "version": "0.2.0",
  "private": true,
  "description": "Walks through websites with only a keyboard and a screen reader, and reports where blind users would get stuck.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "blindfold": "tsx src/cli/blindfold-cli.ts",
    "demo:buggy": "tsx demo-sites/serve-demo-sites.ts buggy",
    "demo:accessible": "tsx demo-sites/serve-demo-sites.ts accessible",
    "demo:both": "tsx demo-sites/serve-demo-sites.ts both",
    "spike:announcer": "tsx spikes/announcer-spike.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  }
}
